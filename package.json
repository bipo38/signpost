{
  "name": "ctx-graph",
  "version": "0.1.0",
  "description": "Visualize and extend the context-pointer docs behind a CLAUDE.md / AGENTS.md file",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ctx-graph": "bin/ctx-graph.mjs"
  },
  "files": [
    "bin",
    "server",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node bin/ctx-graph.mjs --root ../olaaaaaaa/comsart --no-open",
