{
  "name": "@brotzi/signpost",
  "version": "0.2.0",
  "description": "Graph of the context-pointer docs behind CLAUDE.md / AGENTS.md, with a form to add new docs already wired in",
  "type": "module",
  "license": "MIT",
  "bin": {
    "signpost": "bin/signpost.mjs"
  },
  "files": [
    "bin",
    "server",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node bin/signpost.mjs --root example --no-open",
    "build": "vue-tsc --noEmit && vite build",
    "test": "node --test server/*.test.mjs src/*.test.ts",
    "prepare": "vue-tsc --noEmit && vite build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^14.4.0",
    "marked": "^18.0.11",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bipo38/signpost.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agents",
    "agents.md",
    "claude.md",
    "docs",
    "graph",
    "markdown",
    "cli"
  ],
  "author": "Asier Gilaber",
  "homepage": "https://github.com/bipo38/signpost#readme",
  "bugs": {
    "url": "https://github.com/bipo38/signpost/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
